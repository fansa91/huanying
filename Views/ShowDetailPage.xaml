<Page
    x:Class="Huanying.Views.ShowDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SourcePillStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="EpisodeButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="EpisodeContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- 背景大图（低透明度 + 主题色蒙版，浅色/深色主题都成立） -->
        <Grid IsHitTestVisible="False">
            <Image x:Name="BackdropImage"
                   Height="440"
                   Stretch="UniformToFill"
                   VerticalAlignment="Top"
                   Opacity="0.34" />
            <Rectangle Height="440"
                       VerticalAlignment="Top"
                       Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                       Opacity="0.55" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部栏 -->
            <Grid Grid.Row="0" Padding="24,14,24,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;"
                              FontSize="16"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>

                <TextBlock x:Name="HeaderText"
                           Grid.Column="1"
                           Text="详情"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Button x:Name="FavoriteButton"
                        Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10,6"
                        Click="Favorite_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="FavoriteIcon"
                                  Glyph="&#xEB51;"
                                  FontSize="15"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="FavoriteLabel"
                                   Text="收藏"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" Padding="32,4,32,40">
                <StackPanel x:Name="DetailRoot"
                            Spacing="28"
                            MaxWidth="1080"
                            HorizontalAlignment="Left">

                    <!-- 头部：海报 + 信息 -->
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="212"
                                Height="302"
                                CornerRadius="12"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <FontIcon Glyph="&#xE714;"
                                          FontSize="34"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                <Image x:Name="PosterImage" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Text=""
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       LineHeight="40"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <TextBlock x:Name="MetaText"
                                       Text=""
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="StatusBadge"
                                        Padding="9,3"
                                        CornerRadius="4"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock x:Name="StatusText"
                                               Text=""
                                               FontSize="11"
                                               Foreground="White" />
                                </Border>
                                <Border x:Name="ScoreBadge"
                                        Padding="9,3"
                                        CornerRadius="4"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="ScoreText"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                                <Border x:Name="UpdateBadge"
                                        Padding="9,3"
                                        CornerRadius="4"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="UpdateText"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Border>
                                <Border x:Name="SourceBadge"
                                        Padding="9,3"
                                        CornerRadius="4"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="SourceBadgeText"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="DirectorText"
                                       Text=""
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock x:Name="ActorText"
                                       Text=""
                                       FontSize="13"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <Button x:Name="PlayButton"
                                        Content="播放"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinWidth="122"
                                        Click="PlayFirst_Click" />
                                <Button x:Name="ResumeButton"
                                        Visibility="Collapsed"
                                        MinWidth="168"
                                        Click="Resume_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                        <TextBlock x:Name="ResumeButtonText" Text="继续观看" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock x:Name="EpisodeCountText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- 播放线路 -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="播放线路" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel x:Name="SourceBar"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed" />
                        <TextBlock x:Name="NoSourceText"
                                   Text="该节目暂无可播放地址。"
                                   FontSize="13"
                                   Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 选集 -->
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="选集"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="EpisodeSummaryText"
                                           Text=""
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <ComboBox x:Name="SegmentBox"
                                          MinWidth="132"
                                          FontSize="12"
                                          Visibility="Collapsed"
                                          SelectionChanged="Segment_SelectionChanged"
                                          PlaceholderText="选集范围" />
                            </StackPanel>
                        </Grid>

                        <controls:GridView x:Name="EpisodeGrid"
                                           SelectionMode="None"
                                           IsItemClickEnabled="False"
                                           ItemContainerStyle="{StaticResource EpisodeContainerStyle}"
                                           ScrollViewer.VerticalScrollMode="Disabled"
                                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                           ScrollViewer.HorizontalScrollMode="Disabled"
                                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                           HorizontalAlignment="Left">
                            <controls:GridView.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Style="{StaticResource EpisodeButtonStyle}"
                                            Click="Episode_Click" />
                                </DataTemplate>
                            </controls:GridView.ItemTemplate>
                        </controls:GridView>
                    </StackPanel>

                    <!-- 跳过片头 / 片尾设置 -->
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="跳过片头 / 片尾"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button x:Name="ClearSkipButton"
                                        Content="清除"
                                        FontSize="12"
                                        Visibility="Collapsed"
                                        Click="ClearSkip_Click" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="片头"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="IntroNumberBox"
                                           Width="84"
                                           Minimum="0"
                                           Maximum="600"
                                           Value="0"
                                           SpinButtonPlacementMode="Compact"
                                           FontSize="13" />
                                <TextBlock Text="秒"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="片尾"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="OutroNumberBox"
                                           Width="84"
                                           Minimum="0"
                                           Maximum="600"
                                           Value="0"
                                           SpinButtonPlacementMode="Compact"
                                           FontSize="13" />
                                <TextBlock Text="秒"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <Button Content="保存"
                                    FontSize="12"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="SaveSkip_Click" />
                        </StackPanel>

                        <TextBlock x:Name="SkipHintText"
                                   Text="设置后，播放到对应位置会出现跳过按钮。"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- 简介 -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="简介" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="ContentText"
                                   Text=""
                                   FontSize="13"
                                   LineHeight="23"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 加载中 -->
            <controls:ProgressRing x:Name="LoadingRing"
                                   Grid.Row="1"
                                   IsActive="False"
                                   Width="36"
                                   Height="36"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

            <!-- 错误 -->
            <Border x:Name="ErrorPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="560"
                    Padding="24"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="详情加载失败"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ErrorText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="重试"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Retry_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

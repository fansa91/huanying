<Page
    x:Class="Huanying.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="using:Huanying.Controls"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- 分类胶囊按钮 -->
        <Style x:Key="CategoryPillStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Padding="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部：标题 / 搜索 / 视图切换 ============ -->
        <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,14">
            <TextBlock Text="首页"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:AutoSuggestBox x:Name="SearchBox"
                                         PlaceholderText="搜索片名、演员（回车搜索）"
                                         Width="320"
                                         QuerySubmitted="SearchBox_QuerySubmitted" />

                <ToggleButton x:Name="AggregateToggle"
                              Content="聚合搜索"
                              MinWidth="88"
                              Click="AggregateToggle_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="同时搜索多个视频源，合并结果" />
                    </ToolTipService.ToolTip>
                </ToggleButton>

                <Button x:Name="AggregateSourceButton"
                        Content="选择源"
                        MinWidth="76"
                        Visibility="Collapsed"
                        Click="AggregateSourceButton_Click" />

                <ToggleButton x:Name="GridToggle"
                              Content="瀑布流"
                              IsChecked="True"
                              MinWidth="76"
                              Click="ViewToggle_Click" />
                <ToggleButton x:Name="ListToggle"
                              Content="列表"
                              MinWidth="72"
                              Click="ViewToggle_Click" />

                <TextBlock x:Name="CountText"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 聚合搜索的源选择条 -->
            <StackPanel x:Name="AggregateSourceBar"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                <TextBlock Text="参与搜索的源："
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="AggregateSourceChips" Orientation="Horizontal" Spacing="8" />
                <Button Content="全选"
                        FontSize="12"
                        Click="SelectAllSources_Click" />
                <Button Content="仅当前源"
                        FontSize="12"
                        Click="SelectCurrentSource_Click" />
            </StackPanel>
        </StackPanel>

        <!-- ============ 分类胶囊 ============ -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,0,16">
            <StackPanel x:Name="CategoryBar" Orientation="Horizontal" Spacing="8" />
        </ScrollViewer>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Row="2">

            <!-- 瀑布流视图 -->
            <ScrollViewer x:Name="WaterfallScroll"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          ViewChanged="WaterfallScroll_ViewChanged">
                <ItemsRepeater x:Name="WaterfallRepeater">
                    <ItemsRepeater.Layout>
                        <cm:MasonryLayout MinColumnWidth="172"
                                          ColumnSpacing="14"
                                          RowSpacing="14" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid Tapped="Card_Tapped">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <!-- 海报：高度由卡片的数据决定（图片解码后按真实比例校准） -->
                                        <Grid Height="{Binding PosterHeight}"
                                              Background="{ThemeResource ControlFillColorDefaultBrush}">
                                            <cm:QueuedImage SourceUrl="{Binding PicUrl}" DecodeWidth="360" />

                                            <!-- 更新状态角标 -->
                                            <Border VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Left"
                                                    Margin="8"
                                                    Padding="6,2"
                                                    CornerRadius="4"
                                                    Background="#B3000000">
                                                <TextBlock Text="{Binding RemarksText}"
                                                           FontSize="10"
                                                           Foreground="White"
                                                           MaxLines="1" />
                                            </Border>

                                            <!-- 来源标注（仅聚合搜索结果显示） -->
                                            <Border VerticalAlignment="Top"
                                                    HorizontalAlignment="Right"
                                                    Margin="8"
                                                    Padding="6,2"
                                                    CornerRadius="4"
                                                    Background="#CC1B5E20"
                                                    ToolTipService.ToolTip="{Binding SourceDetail}"
                                                    Visibility="{Binding HasSource}">
                                                <TextBlock Text="{Binding SourceLabel}"
                                                           FontSize="10"
                                                           Foreground="White"
                                                           MaxLines="1"
                                                           MaxWidth="118"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Padding="10,8,10,11" Spacing="3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding MetaLine}"
                                                       FontSize="11"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 列表视图 -->
            <ListView x:Name="ListRows"
                      Visibility="Collapsed"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="List_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6" Padding="6" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="112"
                                    Height="63"
                                    CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <cm:QueuedImage SourceUrl="{Binding PicUrl}" DecodeWidth="240" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding MetaLine}"
                                           FontSize="12"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SourceLabel}"
                                           FontSize="11"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding SourceDetail}"
                                           Visibility="{Binding HasSource}"
                                           Foreground="#FF2E7D32" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding RemarksText}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 无源引导：本项目不内置任何接口地址，首次启动就是这个状态 -->
            <Border x:Name="NoSourcePanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520"
                    Padding="32,28"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE774;"
                              FontSize="34"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="还没有视频源"
                               FontSize="19"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="本应用不内置任何接口地址。请先在「源管理」里添加一个苹果CMS（MacCMS V10）JSON 接口，例如 https://你的域名/api.php/provide/vod"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="去添加视频源"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="GoSource_Click" />
                </StackPanel>
            </Border>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyHint"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <FontIcon Glyph="&#xE721;"
                          FontSize="34"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="没有找到相关内容"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 错误面板 -->
            <Border x:Name="ErrorPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="560"
                    Padding="24"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE783;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="加载失败"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="ErrorText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="重试"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Retry_Click" />
                </StackPanel>
            </Border>

            <!-- 加载中 -->
            <controls:ProgressRing x:Name="LoadingRing"
                                   IsActive="False"
                                   Width="36"
                                   Height="36"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
        </Grid>

        <!-- ============ 底部：状态 + 加载更多 ============ -->
        <Grid Grid.Row="3" Margin="0,8,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="QueueText"
                       Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

            <TextBlock x:Name="HintText"
                       Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,4,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Button x:Name="LoadMoreButton"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="加载更多"
                    MinWidth="140"
                    Click="LoadMore_Click" />
        </Grid>
    </Grid>
</Page>

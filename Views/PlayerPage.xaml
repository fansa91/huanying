<Page
    x:Class="Huanying.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!--
        KeyboardAcceleratorPlacementMode="Hidden"：
        默认 Auto 时 WinUI 会给挂了加速键的元素（这里是整个页面）加一个悬停提示，
        鼠标移到画面上就会冒出一条「空格 / ← / → …」的快捷键气泡，挡画面也没意义，这里关掉。
        快捷键本身照常可用。
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="Space_Invoked" />
        <KeyboardAccelerator Key="Left" Invoked="SeekBack_Invoked" />
        <KeyboardAccelerator Key="Right" Invoked="SeekForward_Invoked" />
        <KeyboardAccelerator Key="Up" Invoked="VolumeUp_Invoked" />
        <KeyboardAccelerator Key="Down" Invoked="VolumeDown_Invoked" />
        <KeyboardAccelerator Key="F" Invoked="FullScreen_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        <KeyboardAccelerator Key="M" Invoked="Mute_Invoked" />
        <KeyboardAccelerator Key="I" Invoked="Info_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Style x:Key="PlayerIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <!-- 不参与焦点：否则点过「全屏」再按空格，会重新点一次这个按钮而不是暂停 -->
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>

        <Style x:Key="PlayerTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Background="Black" PreviewKeyDown="Root_PreviewKeyDown">

        <!-- 视频画面 -->
        <controls:MediaPlayerElement x:Name="Player"
                                     AreTransportControlsEnabled="False"
                                     Stretch="Uniform" />

        <!-- 亮度模拟遮罩 -->
        <Rectangle x:Name="BrightnessOverlay"
                   Fill="Black"
                   Opacity="0"
                   IsHitTestVisible="False" />

        <!-- 手势层（覆盖画面，接收拖动 / 单击 / 双击） -->
        <Grid x:Name="GestureLayer"
              Background="Transparent"
              PointerPressed="Gesture_PointerPressed"
              PointerMoved="Gesture_PointerMoved"
              PointerReleased="Gesture_PointerReleased"
              PointerCanceled="Gesture_PointerReleased"
              PointerCaptureLost="Gesture_PointerCaptureLost"
              DoubleTapped="GestureLayer_DoubleTapped" />

        <!-- 缓冲指示 -->
        <controls:ProgressRing x:Name="BufferingRing"
                               IsActive="False"
                               Visibility="Collapsed"
                               Width="46"
                               Height="46"
                               Foreground="White"
                               IsHitTestVisible="False" />

        <!-- 手势提示 -->
        <Border x:Name="GestureHint"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="20,12"
                CornerRadius="10"
                Background="#CC000000"
                IsHitTestVisible="False">
            <TextBlock x:Name="GestureHintText"
                       Text=""
                       FontSize="18"
                       Foreground="White" />
        </Border>

        <!-- 中央播放按钮（暂停时出现） -->
        <Button x:Name="CenterPlayButton"
                Width="78"
                Height="78"
                CornerRadius="39"
                Background="#66000000"
                BorderThickness="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                IsHitTestVisible="False"
                IsTabStop="False"
                Click="PlayPause_Click">
            <FontIcon x:Name="CenterPlayIcon"
                      Glyph="&#xE768;"
                      FontSize="30"
                      Foreground="White" />
        </Button>

        <!-- 顶部栏 -->
        <Border x:Name="TopBar" VerticalAlignment="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B3000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Padding="14,10,16,30" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource PlayerIconButton}"
                        Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="White" />
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TitleText"
                               Text=""
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="White" />
                    <TextBlock x:Name="SubtitleText"
                               Text=""
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#B3FFFFFF" />
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource PlayerTextButton}"
                        Click="ToggleEpisodePanel_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="White" />
                        <TextBlock Text="选集" FontSize="12" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 底部控制栏 -->
        <Border x:Name="BottomBar" VerticalAlignment="Bottom">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#B3000000" Offset="0.5" />
                    <GradientStop Color="#E6000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel Padding="20,30,20,14" Spacing="6">
                <!-- 进度条 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TimeText"
                               Grid.Column="0"
                               Text="00:00"
                               FontSize="12"
                               MinWidth="46"
                               VerticalAlignment="Center"
                               Foreground="#E6FFFFFF" />

                    <Slider x:Name="ProgressSlider"
                            Grid.Column="1"
                            IsTabStop="False"
                            AllowFocusOnInteraction="False"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="1"
                            VerticalAlignment="Center"
                            ValueChanged="ProgressSlider_ValueChanged" />

                    <TextBlock x:Name="DurationText"
                               Grid.Column="2"
                               Text="00:00"
                               FontSize="12"
                               MinWidth="46"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#B3FFFFFF" />
                </Grid>

                <!-- 按钮行 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource PlayerIconButton}"
                                Click="PlayPause_Click">
                            <FontIcon x:Name="BottomPlayIcon" Glyph="&#xE768;" FontSize="17" Foreground="White" />
                        </Button>

                        <Button x:Name="PrevButton"
                                Style="{StaticResource PlayerIconButton}"
                                Click="Prev_Click">
                            <FontIcon Glyph="&#xE892;" FontSize="15" Foreground="White" />
                        </Button>

                        <Button x:Name="NextButton"
                                Style="{StaticResource PlayerIconButton}"
                                Click="Next_Click">
                            <FontIcon Glyph="&#xE893;" FontSize="15" Foreground="White" />
                        </Button>

                        <Button x:Name="MuteButton"
                                Style="{StaticResource PlayerIconButton}"
                                Margin="10,0,0,0"
                                Click="Mute_Click">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="15" Foreground="White" />
                        </Button>

                        <Slider x:Name="VolumeSlider"
                                Width="92"
                                IsTabStop="False"
                                AllowFocusOnInteraction="False"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                StepFrequency="1"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="SpeedButton" Style="{StaticResource PlayerTextButton}">
                            <TextBlock x:Name="SpeedText" Text="1.0x" FontSize="12" Foreground="White" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem Text="0.5x" Tag="0.5" Click="Speed_Click" />
                                    <MenuFlyoutItem Text="0.75x" Tag="0.75" Click="Speed_Click" />
                                    <MenuFlyoutItem Text="1.0x" Tag="1" Click="Speed_Click" />
                                    <MenuFlyoutItem Text="1.25x" Tag="1.25" Click="Speed_Click" />
                                    <MenuFlyoutItem Text="1.5x" Tag="1.5" Click="Speed_Click" />
                                    <MenuFlyoutItem Text="2.0x" Tag="2" Click="Speed_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="PipButton"
                                Style="{StaticResource PlayerTextButton}"
                                Click="Pip_Click">
                            <TextBlock Text="画中画" FontSize="12" Foreground="White" />
                        </Button>

                        <Button x:Name="InfoButton"
                                Style="{StaticResource PlayerIconButton}"
                                Click="ToggleInfo_Click">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="视频信息（I）" />
                            </ToolTipService.ToolTip>
                            <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="White" />
                        </Button>

                        <Button x:Name="FullScreenButton"
                                Style="{StaticResource PlayerIconButton}"
                                Click="FullScreen_Click">
                            <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="15" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 选集侧栏 -->
        <Grid x:Name="EpisodePanel"
              Width="300"
              HorizontalAlignment="Right"
              Visibility="Collapsed"
              Background="#F2000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="18,16,12,10" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="选集"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="White" />

                <Button Grid.Column="1"
                        Style="{StaticResource PlayerIconButton}"
                        Click="CloseEpisodePanel_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                </Button>
            </Grid>

            <ListView x:Name="EpisodeList"
                      Grid.Row="1"
                      Background="Transparent"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="EpisodeList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,7" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Index}"
                                       FontSize="12"
                                       MinWidth="22"
                                       VerticalAlignment="Center"
                                       Foreground="#80FFFFFF" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="White" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 视频信息面板（解码 / 轨道 / 缓冲诊断） -->
        <Grid x:Name="InfoPanel"
              Width="404"
              HorizontalAlignment="Right"
              Visibility="Collapsed"
              Background="#F2000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="18,16,12,10" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="视频信息"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="解码与流信息来自系统媒体管道"
                               FontSize="10"
                               Foreground="#80FFFFFF" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource PlayerIconButton}"
                        Click="CloseInfoPanel_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Padding="18,0,18,8"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          HorizontalScrollMode="Disabled">
                <StackPanel x:Name="InfoRows" Spacing="1" />
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="18,12,18,16"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#1FFFFFFF">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="刷新" FontSize="12" Click="RefreshInfo_Click" />
                    <Button Content="复制信息" FontSize="12" Click="CopyInfo_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 下一集倒计时 -->
        <Border x:Name="NextToast"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,118"
                Padding="16,12"
                MaxWidth="380"
                CornerRadius="10"
                Background="#E6000000">
            <StackPanel Spacing="10">
                <TextBlock x:Name="NextToastText"
                           Text=""
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="White" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="立即播放"
                            FontSize="12"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NextNow_Click" />
                    <Button Content="取消"
                            FontSize="12"
                            Click="CancelNext_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 错误面板 -->
        <Border x:Name="ErrorPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Padding="24"
                CornerRadius="10"
                Background="#F2000000">
            <StackPanel Spacing="12">
                <TextBlock Text="无法播放"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock x:Name="ErrorText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="#B3FFFFFF" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="重试"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Retry_Click" />
                    <Button Content="返回"
                            Click="Back_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>

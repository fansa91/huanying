<Page
    x:Class="Huanying.Views.SourceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SourceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="SourceRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Padding="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 标题 ============ -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,18">
            <TextBlock Text="源管理"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="每个源都是一个苹果CMS JSON 接口。点击任意源即可切换到它，首页会立即换用该源的数据。"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- ============ 工具条 ============ -->
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="AddSource_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                    <TextBlock Text="添加源" FontSize="13" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Click="ImportSubscription_Click"
                    ToolTipService.ToolTip="从一个订阅链接批量导入视频源">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                    <TextBlock Text="订阅导入" FontSize="13" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Click="ImportJsonFile_Click"
                    ToolTipService.ToolTip="从本地 JSON / 文本文件批量导入视频源（可参考仓库根目录的 sources.example.json）">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A1;" FontSize="13" />
                    <TextBlock Text="导入 JSON" FontSize="13" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Margin="4,0,0,0">
                <TextBlock x:Name="ActiveSourceText"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ActiveUrlText"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="4"
                    Content="全部测试"
                    FontSize="12"
                    Click="TestAll_Click" />
        </Grid>

        <!-- ============ 源列表 ============ -->
        <Grid Grid.Row="2">
            <ListView x:Name="SourceItems"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="Source_ItemClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SourceCardStyle}" Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 首字头像 -->
                                <Border Grid.Column="0"
                                        Width="42"
                                        Height="42"
                                        CornerRadius="10"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                    <TextBlock Text="{Binding Initial}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                        <Border Padding="7,1"
                                                CornerRadius="9"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{Binding HasActiveBadge, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="使用中"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Url}"
                                               FontSize="12"
                                               IsTextSelectionEnabled="True"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <TextBlock Text="{Binding Note}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                    <Button Content="{Binding TestButtonText}"
                                            Style="{StaticResource SourceRowButtonStyle}"
                                            IsEnabled="{Binding IsTesting, Converter={StaticResource BoolToVisInverse}}"
                                            Tag="{Binding}"
                                            Click="TestOne_Click" />

                                    <Button Content="使用"
                                            Style="{StaticResource SourceRowButtonStyle}"
                                            Tag="{Binding}"
                                            Visibility="{Binding HasActiveBadge, Converter={StaticResource BoolToVisInverse}}"
                                            Click="UseSource_Click" />

                                    <Button Style="{StaticResource SourceRowButtonStyle}" Tag="{Binding}">
                                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="编辑" Click="EditSource_Click" Tag="{Binding}" />
                                                <MenuFlyoutItem Text="更新订阅" Click="RefreshSubscription_Click" Tag="{Binding}" />
                                                <MenuFlyoutItem Text="复制地址" Click="CopySource_Click" Tag="{Binding}" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="删除" Click="DeleteSource_Click" Tag="{Binding}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyHint"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <FontIcon Glyph="&#xE774;" FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="还没有视频源，点「添加源」填一个苹果CMS 接口地址"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- ============ 提示条 ============ -->
        <controls:InfoBar x:Name="Notice"
                          Grid.Row="3"
                          Margin="0,10,0,16"
                          IsOpen="False"
                          Severity="Success"
                          Title="提示" />
    </Grid>
</Page>

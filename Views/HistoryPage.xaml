<Page
    x:Class="Huanying.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="历史"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="SubtitleText"
                           Text="继续上次未看完的内容"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button x:Name="ClearButton"
                    Grid.Column="1"
                    Content="清空历史"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="ClearHistory_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="HistoryList"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="HistoryList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="16" Padding="10,10" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 缩略图 -->
                            <Border Grid.Column="0"
                                    Width="132"
                                    Height="74"
                                    CornerRadius="8"
                                    Background="{Binding PosterBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE768;"
                                              FontSize="20"
                                              Foreground="White"
                                              Opacity="0.7"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    <Image Source="{Binding Pic, Converter={StaticResource ImgConv}}"
                                           Stretch="UniformToFill" />
                                    <!-- 底部进度条 -->
                                    <ProgressBar Value="{Binding Progress}"
                                                 Maximum="100"
                                                 Height="3"
                                                 VerticalAlignment="Bottom"
                                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                 Background="#40000000" />
                                </Grid>
                            </Border>

                            <!-- 文本信息 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="12"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding LastWatched}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <!-- 续播按钮 -->
                            <Button Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="ContinuePlay_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    <TextBlock Text="{Binding ResumeText}" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <FontIcon Glyph="&#xE81C;"
                          FontSize="40"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="还没有观看记录"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="开始播放任意剧集后，这里会记录进度并支持续播"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

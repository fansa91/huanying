<Page
    x:Class="Huanying.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- 分组卡片 -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,8" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsRowHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="24" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="设置"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- ============ 播放 ============ -->
            <StackPanel Spacing="0">
                <TextBlock Text="播放" Style="{StaticResource SettingsSectionTitleStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="自动播放下一集" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="当前集结束后自动衔接下一集" Style="{StaticResource SettingsRowHintStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="True" OnContent="" OffContent="" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="记住播放进度" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="再次打开时从上次位置继续" Style="{StaticResource SettingsRowHintStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="True" OnContent="" OffContent="" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="默认清晰度" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="播放时优先使用的码率" Style="{StaticResource SettingsRowHintStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="130" SelectedIndex="0">
                                <ComboBoxItem Content="自动" />
                                <ComboBoxItem Content="1080p" />
                                <ComboBoxItem Content="720p" />
                                <ComboBoxItem Content="480p" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="跳过片头片尾" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="可手动配置片头 / 片尾时长" Style="{StaticResource SettingsRowHintStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="False" OnContent="" OffContent="" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 外观 ============ -->
            <StackPanel Spacing="0">
                <TextBlock Text="外观" Style="{StaticResource SettingsSectionTitleStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题" Style="{StaticResource SettingsRowTitleStyle}" />
                            <ComboBox Grid.Column="1" MinWidth="130" SelectedIndex="0">
                                <ComboBoxItem Content="跟随系统" />
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="海报尺寸" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="控制首页网格每行显示的数量" Style="{StaticResource SettingsRowHintStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="130" SelectedIndex="1">
                                <ComboBoxItem Content="紧凑" />
                                <ComboBoxItem Content="标准" />
                                <ComboBoxItem Content="宽松" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="默认视图" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="首页打开时的展示方式" Style="{StaticResource SettingsRowHintStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="130" SelectedIndex="0">
                                <ComboBoxItem Content="网格" />
                                <ComboBoxItem Content="列表" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 视频源 ============ -->
            <StackPanel Spacing="0">
                <TextBlock Text="视频源" Style="{StaticResource SettingsSectionTitleStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <!-- 接口地址（VOD API） -->
                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="接口地址" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="苹果CMS JSON 接口根地址，保存后立即生效"
                                           Style="{StaticResource SettingsRowHintStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBox x:Name="ApiUrlBox"
                                         Width="360"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         PlaceholderText="https://example.com/api.php/provide/vod" />
                                <Button Content="测试连接" Click="TestApi_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                        <Grid Padding="16,10">
                            <TextBlock x:Name="ApiStatusText"
                                       Text=""
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                        <!-- SNI 静默回退 -->
                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SNI 静默回退" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="常规请求失败时，改用不发送 SNI 的直连通道（跳过证书校验）"
                                           Style="{StaticResource SettingsRowHintStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SniFallbackSwitch"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          Toggled="SniFallback_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="已添加的源" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock x:Name="SourceCountText"
                                           Text="管理 CMS JSON 接口，可切换当前使用的源"
                                           Style="{StaticResource SettingsRowHintStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="管理" Click="ManageSources_Click" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="导入 / 导出" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="以 JSON 格式批量迁移源列表" Style="{StaticResource SettingsRowHintStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="导入" />
                                <Button Content="导出" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 关于 ============ -->
            <StackPanel Spacing="0" Margin="0,0,0,12">
                <TextBlock Text="关于" Style="{StaticResource SettingsSectionTitleStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock x:Name="AppVersionText"
                                       Grid.Column="1"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />
                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="运行环境" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text=".NET 10 · Windows App SDK 1.8"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
